# Copy to .env and fill in real values. .env is gitignored — never commit it.

# --- Django ---
SECRET_KEY=generate-a-long-random-string
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Data stores (docker-compose defaults) ---
DATABASE_URL=postgres://goodlane:goodlane@localhost:5432/carrier_agent
REDIS_URL=redis://localhost:6379/0

# --- Demo clock (business dates resolve against this, PRD demo day) ---
DEMO_AS_OF_DATE=2026-05-25

# --- Providers ---
OPENAI_API_KEY=sk-...
DEEPGRAM_API_KEY=...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_CAPTURE_PAYLOADS=true

# --- Demo account (created by a management command, never hardcoded) ---
DEMO_USER_EMAIL=broker@goodlanelogistics.com
DEMO_USER_PASSWORD=choose-a-unique-generated-password
